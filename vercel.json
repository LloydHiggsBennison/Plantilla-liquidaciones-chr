{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/gateway.js": {
      "includeFiles": "private-dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/gateway?asset=:path*"
    }
  ]
}
